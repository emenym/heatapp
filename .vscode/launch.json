{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "compounds": [
        {
                        "name": "HeatApp",
                        "configurations": ["Python: Flask", "poller"],
                        "stopAll": true
                },
                {
                        "name": "Reborn Backend",
                        "configurations": ["Reborn: API", "Reborn: Poller"],
                        "stopAll": true
                },
                {
                        "name": "Reborn Full Stack",
                        "configurations": [
                                "Reborn: API",
                                "Reborn: Poller",
                        "Reborn UI: Vite Dev Server"
                        ],
                        "stopAll": true
        }
        ],
    "configurations": [
        {
            "name": "Python: Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "heat",
                "FLASK_DEBUG": "1",
                "MONGODB_PWD": "idunnosomething",
                "DEBUG": "True",
            },
            "args": [
                "run",
                // "--no-debugger",
                // "--no-reload", // doesnt seem to like working along side another instance
                "--host=0.0.0.0"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "poller",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/poller.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "MONGODB_PWD": "idunnosomething",
                "DEBUG": "True",
            }
        },
        {
            "name": "Reborn: API",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/reborn_heat.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "REBORN_PORT": "8081",
                "REBORN_DB_PATH": "${workspaceFolder}/reborn_data/heat_reborn.sqlite3",
                "REBORN_ZONE_SEED": "${workspaceFolder}/zones.json",
                "REBORN_DEBUG": "1"
            }
        },
        {
            "name": "Reborn: Poller",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/reborn_poller.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "REBORN_DB_PATH": "${workspaceFolder}/reborn_data/heat_reborn.sqlite3",
                "REBORN_ZONE_SEED": "${workspaceFolder}/zones.json",
                "REBORN_DEBUG": "1"
            }
        },
        {
            "name": "Reborn UI: Vite Dev Server",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/reborn_ui",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"],
            "env": {
                "VITE_PROXY_TARGET": "http://localhost:8081"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"],
            "serverReadyAction": {
                "pattern": "Local:\\s+(https?://\\S+)",
                "action": "startDebugging",
                "name": "Reborn UI: Browser"
            }
        },
        {
            "name": "Reborn UI: Browser",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/reborn_ui/src"
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "MONGODB_PWD": "idunnosomething",
                "DEBUG": "True",
            }
        }
    ]
}